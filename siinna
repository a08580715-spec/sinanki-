-- === 2. ESP機能 ===
local function updateESP()
    if not isESPEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character then
                for _, part in pairs(player.Character:GetChildren()) do
                    local esp = part:FindFirstChild(ESP_NAME)
                    if esp then esp:Destroy() end
                end
            end
        end
        return
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isEnemy = (player.Team ~= LocalPlayer.Team or player.Team == nil)
            local char = player.Character
            if char and isEnemy then
                local targetPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                if targetPart then
                    local esp = targetPart:FindFirstChild(ESP_NAME)
                    if not esp then
                        local b = Instance.new("BillboardGui", targetPart)
                        b.Name = ESP_NAME
                        b.AlwaysOnTop = true
                        b.Size = UDim2.new(4, 0, 4.5, 0)
                        b.StudsOffset = Vector3.new(0, 3, 0)
                        
                        local icon = Instance.new("ImageLabel", b)
                        icon.Size = UDim2.new(0.5, 0, 0.5, 0)
                        icon.Position = UDim2.new(0.25, 0, 0, 0)
                        icon.BackgroundTransparency = 1
                        icon.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"
                        
                        local l = Instance.new("TextLabel", b)
                        l.Size = UDim2.new(1, 0, 0.3, 0)
                        l.Position = UDim2.new(0, 0, 0.55, 0)
                        l.Text = player.Name
                        l.TextColor3 = Color3.fromRGB(255, 0, 0)
                        l.TextStrokeTransparency = 0
                        l.BackgroundTransparency = 1
                        l.TextScaled = true
                        l.Font = Enum.Font.SourceSansBold
                    end
                end
            end
        end
    end
end

-- === 3. ロジック：可視判定と高精度部位選択 ===
local function isPartVisible(part)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end

local function getBestTarget()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local minWeight = math.huge
    local targetPart = nil
    
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and (player.Team ~= LocalPlayer.Team or player.Team == nil) then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")
            
            if hum and hum.Health > 0 then
                local selectedPart = nil
                local forceHeadshot = (math.random(1, 100) <= HEADSHOT_CHANCE)

                if forceHeadshot and head and isPartVisible(head) then
                    selectedPart = head
                elseif root and isPartVisible(root) then
                    selectedPart = root
                elseif head and isPartVisible(head) then
                    selectedPart = head
                end

                if selectedPart then
                    local pos, onScreen = Camera:WorldToViewportPoint(selectedPart.Position)
                    if onScreen then
                        local fovDist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if fovDist < FOV_RADIUS then
                            local distToMe = (selectedPart.Position - myRoot.Position).Magnitude
                            local weight = distToMe + (fovDist * 0.4)
                            if weight < minWeight then
                                targetPart = selectedPart
                                minWeight = weight
                            end
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

