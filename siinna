-- === 7. メイン実行ループ ===
RunService:BindToRenderStep("SuperLockCombined", Enum.RenderPriority.Camera.Value + 1, function()
    if isESPEnabled then
        updateESP()
    end
    
    if isAimbotEnabled then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum and hum.WalkSpeed ~= SAFE_SPEED then
            hum.WalkSpeed = SAFE_SPEED
        end
        
        local target = getBestTarget()
        if target then
            local targetPos = target.Position + (target.Velocity * PREDICTION)
            local lookAtCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(lookAtCFrame, LOCK_STRENGTH)
        end
    end
end)

