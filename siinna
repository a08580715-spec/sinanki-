-- === 5. 仰向け＋360度回転機能（ジャンプで自動起き上がり版） ===
local function disableDownMode()
    if fallenLoopConnection then fallenLoopConnection:Disconnect() fallenLoopConnection = nil end
    if fallenJumpConnection then fallenJumpConnection:Disconnect() fallenJumpConnection = nil end
    if spaceConnection then spaceConnection:Disconnect() spaceConnection = nil end
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoid then humanoid.PlatformStand = false end
        if rootPart then
            local _, yaw, _ = rootPart.CFrame:ToOrientation()
            rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.fromOrientation(0, yaw, 0)
            rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
        end
    end
    
    DownButton.Text = "仰向けに倒す"
    DownButton.BackgroundColor3 = Color3.fromRGB(90, 255, 90)
    isDownEnabled = false
end

local function enableDownMode()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    humanoid.PlatformStand = true
    
    local startTime = tick()
    local _, baseYaw, _ = rootPart.CFrame:ToOrientation()
    
    fallenLoopConnection = RunService.RenderStepped:Connect(function()
        if character and rootPart and humanoid and humanoid.PlatformStand then
            local elapsed = tick() - startTime
            local rotAngle = (elapsed * ROTATION_SPEED) % 360
            local rotRad = math.rad(rotAngle)
            
            rootPart.CFrame = CFrame.new(rootPart.Position) 
                * CFrame.fromOrientation(0, baseYaw, 0) 
                * CFrame.fromOrientation(math.rad(-90), rotRad, 0)
            
            local moveDirection = humanoid.MoveDirection
            if moveDirection.Magnitude > 0 then
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    moveDirection.X * FALLEN_SPEED, 
                    rootPart.AssemblyLinearVelocity.Y, 
                    moveDirection.Z * FALLEN_SPEED
                )
            else
                rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
            end
        end
    end)
    
    local function handleJumpTrigger()
        if isDownEnabled then
            disableDownMode()
        end
    end
    
    fallenJumpConnection = UserInputService.JumpRequest:Connect(handleJumpTrigger)
    
    spaceConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.Space then
            handleJumpTrigger()
        end
    end)
    
    DownButton.Text = "起き上がる"
    DownButton.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
end


